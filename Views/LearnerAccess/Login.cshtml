@model LearnerLoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<div class="lex-auth-card">
    <div class="lex-auth-brand">
        <h1>LexoraED</h1>
        <p style="color: var(--lex-text-muted); margin: 0.5rem 0 0;">Microlearning for English mastery</p>
    </div>
    <form asp-action="Login" method="post">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="lex-alert lex-alert-error">
                <div asp-validation-summary="All"></div>
            </div>
        }
        <div class="lex-form-group">
            <label asp-for="Username" class="lex-form-label"></label>
            <input asp-for="Username" class="lex-form-input" placeholder="Your username" />
            <span asp-validation-for="Username" class="lex-text-danger"></span>
        </div>
        <div class="lex-form-group">
            <label asp-for="Password" class="lex-form-label"></label>
            <input asp-for="Password" class="lex-form-input" placeholder="••••••••" />
            <span asp-validation-for="Password" class="lex-text-danger"></span>
        </div>
        <button type="submit" class="lex-btn lex-btn-primary lex-btn-block" style="margin-top: 0.5rem;">Sign In</button>
    </form>
    <p style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--lex-text-muted);">
        New learner? <a asp-action="Register" style="color: var(--lex-violet-700); font-weight: 600;">Create account</a>
    </p>
    <p style="text-align: center; margin-top: 1rem; font-size: 0.75rem; color: var(--lex-text-muted);">
        Demo: student / Student@123 · teacher / Teacher@123 · admin / Admin@123
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
