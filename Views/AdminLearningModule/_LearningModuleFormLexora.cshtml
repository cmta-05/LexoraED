@model LearningModuleFormViewModel

<div asp-validation-summary="ModelOnly" class="lex-text-danger"></div>

<div class="lex-form-group">
    <label asp-for="Title" class="lex-form-label"></label>
    <input asp-for="Title" class="lex-form-input" />
    <span asp-validation-for="Title" class="lex-text-danger"></span>
</div>
<div class="lex-form-group">
    <label asp-for="Description" class="lex-form-label"></label>
    <textarea asp-for="Description" class="lex-form-input" rows="2"></textarea>
    <span asp-validation-for="Description" class="lex-text-danger"></span>
</div>
<div class="lex-form-group">
    <label asp-for="Content" class="lex-form-label"></label>
    <textarea asp-for="Content" class="lex-form-input" rows="6"></textarea>
    <span asp-validation-for="Content" class="lex-text-danger"></span>
</div>
<div class="lex-form-group">
    <label asp-for="Category" class="lex-form-label"></label>
    <select asp-for="Category" class="lex-form-input" asp-items="Html.GetEnumSelectList<ModuleCategory>()"></select>
</div>
<div class="lex-form-group">
    <label asp-for="DifficultyLevel" class="lex-form-label"></label>
    <select asp-for="DifficultyLevel" class="lex-form-input" asp-items="Html.GetEnumSelectList<DifficultyLevel>()"></select>
</div>
