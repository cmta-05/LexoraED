@model StudyModuleViewModel
@{
    ViewData["Title"] = Model.Title;
    var levelClass = Model.DifficultyLevel switch
    {
        DifficultyLevel.Beginner => "lex-badge-beginner",
        DifficultyLevel.Intermediate => "lex-badge-intermediate",
        _ => "lex-badge-advanced"
    };
}

<nav style="margin-bottom:1rem">
    <a asp-action="Dashboard" class="lex-btn lex-btn-ghost lex-btn-sm">← Dashboard</a>
</nav>

<div class="lex-lesson">
    <header class="lex-lesson-header">
        <div class="lex-badge-row">
            <span class="lex-badge lex-badge-category">@Model.Category</span>
            <span class="lex-badge @levelClass">@Model.DifficultyLevel</span>
        </div>
        <h1 style="font-family:'Fraunces',Georgia,serif">@Model.Title</h1>
        <p style="color:var(--lex-text-muted)">@Model.Description</p>
    </header>

    <article class="glass-card lex-lesson-body" data-module-id="@Model.Id">
        @foreach (var block in Model.Content.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
        {
            if (block.StartsWith("## "))
            {
                <h2 style="color:var(--lex-deep-violet);margin-top:1.5rem">@block[3..]</h2>
            }
            else
            {
                <p>@block</p>
            }
        }
    </article>

    <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap">
        @if (Model.HasQuiz)
        {
            <a asp-controller="QuizAssessment" asp-action="TakeQuiz" asp-route-moduleId="@Model.Id" class="lex-btn lex-btn-primary">Take Quiz</a>
        }
        <a asp-action="LearningModules" class="lex-btn lex-btn-secondary">All Modules</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/lexora-offline.js" asp-append-version="true"></script>
}
