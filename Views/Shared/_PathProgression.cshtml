@model PathProgressionViewModel
@using LexoraED.Models

<div class="lex-path-track">
    <div class="lex-path-step unlocked @(Model.CurrentLevel == DifficultyLevel.Beginner ? "current" : "")">
        <div class="lex-path-node"><span>B</span></div>
        <span class="lex-path-label">Beginner</span>
    </div>
    <div class="lex-path-step @(Model.IntermediateUnlocked ? "unlocked" : "locked") @(Model.CurrentLevel == DifficultyLevel.Intermediate ? "current" : "")">
        <div class="lex-path-node"><span>I</span></div>
        <span class="lex-path-label">Intermediate</span>
    </div>
    <div class="lex-path-step @(Model.AdvancedUnlocked ? "unlocked" : "locked") @(Model.CurrentLevel == DifficultyLevel.Advanced ? "current" : "")">
        <div class="lex-path-node"><span>A</span></div>
        <span class="lex-path-label">Advanced</span>
    </div>
</div>
@if (Model.RecommendedModuleId.HasValue)
{
    <p class="lex-path-hint">
        <strong>Up next:</strong> @Model.RecommendedModuleTitle
    </p>
}
