@using LexoraED.Models
@using LexoraED.Services
@{
    var learnerId = Context.Session.GetInt32(LearnerSessionKeys.LearnerId);
    var role = Context.Session.GetString(LearnerSessionKeys.LearnerRole);
    var fullName = Context.Session.GetString(LearnerSessionKeys.LearnerFullName) ?? "Learner";
    var isAdmin = role == LearnerRole.Admin.ToString();
    var isTeacher = role == LearnerRole.Teacher.ToString();
    var isStudent = role == LearnerRole.Student.ToString();
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();
    if (string.IsNullOrEmpty(initials)) { initials = "L"; }
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LexoraED</title>
    <link rel="stylesheet" href="~/css/lexora.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="lexora-body">
<div class="lex-app">
    <aside class="lex-sidebar" id="lexSidebar">
        <div class="lex-brand">
            <a class="lex-brand-logo" asp-controller="Home" asp-action="Index">Lexora<span>ED</span></a>
            <div class="lex-brand-tagline">Violet Dusk · Adaptive LMS</div>
        </div>
        <ul class="lex-nav">
            @if (isAdmin)
            {
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "AdminLearnerManagement" ? "active" : "")" asp-controller="AdminLearnerManagement" asp-action="Index">User Management</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "AdminLearningModule" ? "active" : "")" asp-controller="AdminLearningModule" asp-action="Index">Learning Modules</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "AdminLearningModule" && action == "ProgressAnalytics" ? "active" : "")" asp-controller="AdminLearningModule" asp-action="ProgressAnalytics">Analytics</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "LexoraReports" ? "active" : "")" asp-controller="LexoraReports" asp-action="AdminReport">Reports</a></li>
            }
            else if (isTeacher)
            {
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "TeacherDashboard" && action == "Dashboard" ? "active" : "")" asp-controller="TeacherDashboard" asp-action="Dashboard">Teacher Dashboard</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "TeacherLearningModule" ? "active" : "")" asp-controller="TeacherLearningModule" asp-action="Index">Module Management</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "TeacherQuizManagement" ? "active" : "")" asp-controller="TeacherQuizManagement" asp-action="Index">Quiz Management</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "TeacherDashboard" && action == "ProgressAnalytics" ? "active" : "")" asp-controller="TeacherDashboard" asp-action="ProgressAnalytics">Student Analytics</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "LexoraReports" ? "active" : "")" asp-controller="LexoraReports" asp-action="TeacherReport">Reports</a></li>
            }
            else if (isStudent)
            {
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "StudentLearning" && action == "Dashboard" ? "active" : "")" asp-controller="StudentLearning" asp-action="Dashboard">Dashboard</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "StudentLearning" && action == "LearningPathMap" ? "active" : "")" asp-controller="StudentLearning" asp-action="LearningPathMap">Learning Path</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "StudentLearning" && action == "LearningModules" ? "active" : "")" asp-controller="StudentLearning" asp-action="LearningModules">Learning Modules</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "QuizAssessment" ? "active" : "")" asp-controller="QuizAssessment" asp-action="QuizCenter">Quiz Center</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "StudentLearning" && action == "ProgressAnalytics" ? "active" : "")" asp-controller="StudentLearning" asp-action="ProgressAnalytics">Progress Analytics</a></li>
                <li class="lex-nav-item"><a class="lex-nav-link @(controller == "LexoraReports" ? "active" : "")" asp-controller="LexoraReports" asp-action="StudentReport">Reports</a></li>
            }
        </ul>
        <div class="lex-sidebar-footer">
            <form asp-controller="LearnerAccess" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="lex-btn lex-btn-ghost lex-btn-block lex-signout">Sign Out</button>
            </form>
        </div>
    </aside>
    <div class="lex-main-wrap">
        <header class="lex-header glass-header">
            <button type="button" class="lex-sidebar-toggle" id="sidebarToggle" aria-label="Toggle menu">☰</button>
            <h1 class="lex-header-title">@ViewData["Title"]</h1>
            <div class="lex-header-user">
                <div>
                    <div class="lex-user-name">@fullName</div>
                    <div class="lex-user-role">@(isAdmin ? "Administrator" : isTeacher ? "Teacher" : "Student")</div>
                </div>
                <div class="lex-avatar">@initials</div>
            </div>
        </header>
        <main class="lex-content">
            @if (TempData["LexoraMessage"] != null)
            {
                <div class="lex-alert lex-alert-info">@TempData["LexoraMessage"]</div>
            }
            @RenderBody()
        </main>
    </div>
</div>
<script>
    document.getElementById('sidebarToggle')?.addEventListener('click', () => {
        document.getElementById('lexSidebar')?.classList.toggle('open');
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
