@model LearningPathMapViewModel

<div class="lex-path-map" id="learningPathMap">
    @for (var i = 0; i < Model.Nodes.Count; i++)
    {
        var node = Model.Nodes[i];
        var stateClass = node.State.ToString().ToLowerInvariant();
        <div class="lex-path-map-item @stateClass" title="@node.Title">
            @if (i > 0)
            {
                <div class="lex-path-map-connector @(node.State == PathMapNodeState.Locked ? "locked" : "active")"></div>
            }
            <a asp-controller="StudentLearning" asp-action="StudyModule" asp-route-id="@node.ModuleId"
               class="lex-path-map-node @stateClass @(node.State == PathMapNodeState.Locked ? "disabled" : "")">
                <span class="lex-path-map-icon">
                    @(node.State == PathMapNodeState.Completed ? "✓" : node.State == PathMapNodeState.Locked ? "🔒" : (i + 1))
                </span>
                <span class="lex-path-map-label">@node.Title</span>
            </a>
        </div>
    }
</div>
