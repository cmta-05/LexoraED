@model LearnerFormViewModel
@{ ViewData["Title"] = "Edit User"; }
<div class="glass-card" style="padding:1.5rem;max-width:520px">
    <h2>Edit User</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_LearnerForm" model="Model" />
        <button type="submit" class="lex-btn lex-btn-primary">Save</button>
        <a asp-action="Index" class="lex-btn lex-btn-ghost">Cancel</a>
    </form>
    <hr />
    <form asp-action="ResetPassword" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <label class="lex-form-label">Reset Password</label>
        <input type="password" name="newPassword" class="lex-form-input" required minlength="6" />
        <button type="submit" class="lex-btn lex-btn-secondary lex-btn-sm" style="margin-top:0.5rem">Reset Password</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
